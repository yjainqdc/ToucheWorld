# Copy to config.env and adjust paths. This file is sourced by scripts/common.sh.
# Activate the Python environment used by the compatible LTX-2.5 / SolarWM sources.
LTX25_ROOT=/path/to/LTX-2.5
SOLAR_SRC=/path/to/SolarWM/src
LTX25_PYTHON=python

# Media paths in JSONL manifests are resolved relative to DATA_ROOT.
DATA_ROOT=/path/to/dataset
JSONL=/path/to/dataset/train/train.jsonl
CACHE_DIR=/path/to/latent-cache
MODEL_DIR=/path/to/models

TRANSFORMER=/path/to/models/ltx-2.5-22b-dev-transformer-bf16.safetensors
VAE=/path/to/models/ltx-2.5-video-vae-bf16.safetensors
GEMMA=/path/to/models/gemma4-12b-with-proj-ltx-2.5-bf16.safetensors
CAMERA=/path/to/models/camera_adapter.safetensors

# Optional: override each launcher with command-line environment variables.
# RUN_DIR=/path/to/ToucheWorld/teacher27
# HAND_RUN=/path/to/ToucheWorld/causal27
# DISTILL_RUN=/path/to/ToucheWorld/causal27
# TRAIN_GPUS=0
# PREENCODE_GPUS=0
